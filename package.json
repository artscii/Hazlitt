{
  "name": "hazlitt-creek-evidence-atlas",
  "version": "4.13.27",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/local.mjs",
    "db:generate": "drizzle-kit generate",
    "release:patch": "npm version patch --no-git-tag-version && npm run build",
    "test": "npm run build && node scripts/test.mjs",
    "format": "prettier --write src server pilot/*.mjs scripts tests dist/app.js dist/thesaurus-admin.js dist/semantic-search.js",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "dependency-cruiser": "17.3.1",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "esbuild": "0.25.10",
    "jsdom": "30.1.0",
    "mermaid": "11.12.0",
    "prettier": "3.6.2",
    "yaml": "2.8.1"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "geoip-country": "5.0.202609230144",
    "proxy-addr": "2.0.8"
  }
}
